############################################
# Основные настройки приложения
############################################
APP_NAME=Laravel
APP_ENV=local                        # Окружение (local, production, staging)
APP_KEY=base64:VFC3YtqYl95e/52nwxpwkwwPLagTyb2VBIfn+gbboSc=    # Ключ шифрования (автоматически генерируется)
APP_DEBUG=true                        # Включить режим отладки? (true - показывать ошибки)
APP_URL=http://localhost              # Базовый URL приложения
APP_LOCALE=en                         # Язык (ошибки и прочее)

############################################
# Логирование
############################################
LOG_CHANNEL=stack                     # Где хранить логи (stack, single, daily)
LOG_LEVEL=debug                        # Уровень логирования (debug, info, warning, error)

############################################
# Настройки базы данных (MySQL)
############################################
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=uiygGGy1!guyghiuhi

############################################
# Кэширование и сессии (без Redis)
############################################
CACHE_DRIVER=file                      # Где хранить кэш (file, database, array)
SESSION_DRIVER=file                     # Где хранить сессии (file, cookie, database)
SESSION_LIFETIME=120                    # Время жизни сессии в минутах (120 = 2 часа)

############################################
# Почта (SMTP)
############################################
MAIL_MAILER=smtp                       # Как отправлять письма (smtp, sendmail, mailgun)
MAIL_HOST=smtp.mailtrap.io             # SMTP-сервер (например, smtp.gmail.com)
MAIL_PORT=2525                          # Порт SMTP (465 для Gmail, 2525 для Mailtrap)
MAIL_USERNAME=null                      # Имя пользователя SMTP
MAIL_PASSWORD=null                      # Пароль SMTP
MAIL_ENCRYPTION=null                    # Способ шифрования (tls, ssl, null)
MAIL_FROM_ADDRESS="hello@example.com"   # Email отправителя
MAIL_FROM_NAME="${APP_NAME}"            # Имя отправителя (по умолчанию APP_NAME)

############################################
# Очереди (без Redis)
############################################
QUEUE_CONNECTION=sync                   # Как обрабатывать очереди (sync - синхронно, database)

############################################
# Удалённые настройки (без Redis)
############################################
# REDIS_HOST=127.0.0.1                    # Адрес сервера Redis
# REDIS_PASSWORD=null                      # Пароль Redis (обычно null)
# REDIS_PORT=6379                          # Порт Redis (обычно 6379)

############################################
# Настройки API (если подключены)
############################################
API_KEY=null                             # Ключ API (например, для внешних сервисов)